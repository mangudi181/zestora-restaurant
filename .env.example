# GEMINI_API_KEY: Optional if using Gemini features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT Secret for user & admin authentication
JWT_SECRET="zestora_super_secret_jwt_key_2026"

# MongoDB connection string (Optional: if provided, server connects to Mongo; otherwise uses built-in high-performance persistent JSON DB)
MONGODB_URI="mongodb://localhost:27017/zestora_restaurant"

# Server Port
PORT=3000

